{
  "name": "naming-police",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @naming-police/desktop dev",
    "tauri": "pnpm --filter @naming-police/desktop tauri",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
